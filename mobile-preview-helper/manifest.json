{
  "manifest_version": 3,
  "name": "Mobile Preview Helper",
  "version": "1.2.0",
  "description": "Companion for the Mobile Preview tool (index.html): finger tracking inside the phone, iPhone user agent, dark mode, embedding of sites that refuse iframes, and Chrome-account sync of the tool's home screen and settings.",
  "key": "",
  "permissions": ["declarativeNetRequestWithHostAccess", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["ua.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
